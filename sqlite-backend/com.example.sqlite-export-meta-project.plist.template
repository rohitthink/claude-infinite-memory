<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist template: 15-min Session Log + Technical Learnings export
  (SQLite → per-device markdown).

  This is the companion to com.example.sqlite-export.plist.template which
  handles the hourly User Profile export. This agent runs every 15 minutes
  to keep Session Log and Technical Learnings markdown fresh after the
  SessionEnd hook ingests to SQLite.

  Per-device routing is enforced by the exporter: session log rows are
  written to Session Log - <hostname>.md (keyed on sessions.hostname),
  NOT to the canonical Session Log.md. Technical Learnings.md is canonical.

  INSTALLATION (one-time setup):
    1. Replace every REPLACE_WITH_* placeholder with real paths.
    2. Copy to ~/Library/LaunchAgents/:
         cp com.example.sqlite-export-meta-project.plist.template \
            ~/Library/LaunchAgents/com.example.sqlite-export-meta-project.plist
    3. Load the agent:
         launchctl load ~/Library/LaunchAgents/com.example.sqlite-export-meta-project.plist
    4. Verify it loaded:
         launchctl list | grep sqlite-export-meta

  UNINSTALL:
    launchctl unload ~/Library/LaunchAgents/com.example.sqlite-export-meta-project.plist
    rm ~/Library/LaunchAgents/com.example.sqlite-export-meta-project.plist

  NOTES:
  - StartInterval 900 = run every 15 minutes. Session log is high-churn;
    a user expects to see fresh markdown within minutes of a session ending.
  - The export is a no-op when there are no pending rows, so frequent runs
    are very cheap (a single COUNT(*) query + no lock contention).
  - RunAtLoad false: first run occurs at the next interval tick. Set to
    <true/> if you want an immediate render on agent load.
  - To bootstrap a new device from an existing DB, run manually:
      CLAUDE_BRIDGE_HOME=... CLAUDE_BRIDGE_VAULT=... \
        ~/.claude/sqlite-backend/export-to-vault.sh --full-rebuild
  - StandardOutPath / StandardErrorPath both write to the same log file.
    Rotate it with a companion logrotate / newsyslog rule if needed.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.sqlite-export.meta-project</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPLACE_WITH_CLAUDE_BRIDGE_HOME/sqlite-backend/export-to-vault.sh</string>
        <string>--section</string>
        <string>meta-project</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Path to your ~/.claude (or wherever CLAUDE_BRIDGE_HOME lives). -->
        <key>CLAUDE_BRIDGE_HOME</key>
        <string>REPLACE_WITH_CLAUDE_BRIDGE_HOME</string>

        <!-- Absolute path to your Obsidian vault root. -->
        <key>CLAUDE_BRIDGE_VAULT</key>
        <string>REPLACE_WITH_VAULT_PATH</string>
    </dict>

    <!-- Run every 900 seconds (15 minutes). Session log is high-churn. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Do not fire immediately on launchctl load. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Do not restart the agent if it exits (cron-style, not daemon-style). -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_CLAUDE_BRIDGE_HOME/logs/sqlite-export-meta-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_CLAUDE_BRIDGE_HOME/logs/sqlite-export-meta-launchd.log</string>
</dict>
</plist>
