<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent plist template for the obsidian-reconciliation daemon.

  Before loading, substitute:
    {{LABEL_PREFIX}}      reverse-DNS prefix, e.g. com.github.yourhandle
    {{DAEMON_PATH}}       absolute path to obsidian-reconciliation-daemon.sh
    {{CLAUDE_BRIDGE_HOME}} absolute path, e.g. /Users/you/.claude
    {{CLAUDE_BRIDGE_VAULT}} absolute path to your Obsidian vault
    {{CLAUDE_BIN}}        absolute path to claude CLI (e.g. /opt/homebrew/bin/claude)

  The install.sh script performs these substitutions automatically and writes
  the resulting plist to ~/Library/LaunchAgents/ (which is the boot drive,
  NOT an external volume — see docs/macos-specific.md for the reason).

  Load:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/{{LABEL_PREFIX}}.obsidian-reconciliation.plist

  Unload:
    launchctl bootout gui/$(id -u)/{{LABEL_PREFIX}}.obsidian-reconciliation
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL_PREFIX}}.obsidian-reconciliation</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{DAEMON_PATH}}</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>Nice</key>
    <integer>10</integer>

    <key>LowPriorityBackgroundIO</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>{{CLAUDE_BRIDGE_HOME}}/logs/reconciler-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{CLAUDE_BRIDGE_HOME}}/logs/reconciler-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLAUDE_BRIDGE_HOME</key>
        <string>{{CLAUDE_BRIDGE_HOME}}</string>
        <key>CLAUDE_BRIDGE_VAULT</key>
        <string>{{CLAUDE_BRIDGE_VAULT}}</string>
        <key>CLAUDE_BRIDGE_CLAUDE_BIN</key>
        <string>{{CLAUDE_BIN}}</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
