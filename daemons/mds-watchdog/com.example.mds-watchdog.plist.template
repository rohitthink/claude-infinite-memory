<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent plist template for the mds-watchdog.

  Runs every 15 minutes and checks whether Spotlight (mds / mds_stores /
  mdworker_shared) is consuming excessive CPU, whether the
  .metadata_never_index flag file is still in place, and whether the
  Spotlight metadata cache has grown to a pathological size.

  IMPORTANT: The plist file itself must live on the boot drive
  (~/Library/LaunchAgents/). See docs/macos-specific.md for details.

  This plist is NOT bootstrapped by install.sh. To opt in, run:
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/<label>.mds-watchdog.plist

  Before loading, substitute:
    {{LABEL_PREFIX}}         reverse-DNS prefix, e.g. com.github.yourhandle
    {{WATCHDOG_PATH}}        absolute path to mds-watchdog.sh
    {{CLAUDE_BRIDGE_HOME}}   absolute path, e.g. /Users/you/.claude
    {{CLAUDE_BRIDGE_VAULT}}  absolute path to your Obsidian vault

  The install.sh script performs these substitutions automatically.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL_PREFIX}}.mds-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{WATCHDOG_PATH}}</string>
    </array>

    <!-- Run every 15 minutes (900 seconds). -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Low priority — this is a background health check. -->
    <key>Nice</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>{{CLAUDE_BRIDGE_HOME}}/logs/mds-watchdog-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{CLAUDE_BRIDGE_HOME}}/logs/mds-watchdog-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>CLAUDE_BRIDGE_HOME</key>
        <string>{{CLAUDE_BRIDGE_HOME}}</string>
        <key>CLAUDE_BRIDGE_VAULT</key>
        <string>{{CLAUDE_BRIDGE_VAULT}}</string>
    </dict>
</dict>
</plist>
